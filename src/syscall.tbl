# system call numbers and entry vectors
# The format is:
# <number> <name> <entry point>

0       listsyscall sys_listsyscall
17      memmap	    sys_memmap
440     kmalloc             sys_kmalloc
441     kfree               sys_kfree
442     kmem_cache_create   sys_kmem_cache_create
443     kmem_cache_alloc    sys_kmem_cache_alloc
444     copy_from_user      sys_copy_from_user
445     copy_to_user        sys_copy_to_user
